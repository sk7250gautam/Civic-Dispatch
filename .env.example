# ==============================================================================
# CIVIC DISPATCH — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Flask Server
FLASK_ENV=development
SECRET_KEY=civic-dispatch-super-secret-key-change-in-production-2026
PORT=5000

# Database (PostgreSQL with PostGIS for production; leave empty for dev SQLite)
POSTGRES_USER=civic_admin
POSTGRES_PASSWORD=civic_secure_pass_2026
POSTGRES_DB=civic_dispatch
DATABASE_URL=postgresql://civic_admin:civic_secure_pass_2026@localhost:5432/civic_dispatch

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate Limiting
RATELIMIT_DEFAULT="200 per day;50 per hour"
RATELIMIT_STORAGE_URI=memory://

# AI Capabilities (local fallback is 100% deterministic and offline-ready)
AI_PROVIDER=local
GEMINI_API_KEY=

# Municipal Operational Parameters
DEFAULT_COORDINATE_TOLERANCE_METERS=250.0
DEFAULT_SLA_CHECK_INTERVAL_SECONDS=300
