# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database & Uploads
*.db
*.sqlite3
backend/civic_dispatch.db
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
instance/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Node.js & Frontend
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.vite/
.vite/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# Operating System & Editors
.DS_Store
Thumbs.db
*.swp
*.swo
*~
